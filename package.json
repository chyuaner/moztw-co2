{
  "name": "moztw-co2",
  "type": "module",
  "scripts": {
    "build:client": "vite build",
    "build:css": "tailwindcss -i ./src/core/frontend/input.css -o ./gen/output.css --minify",
    "build:assets": "npm run build:client && npm run build:css && tsx scripts/generate-assets.ts",
    "dev": "npm run dev:worker",
    "dev:worker": "npm run build:assets && wrangler dev",
    "dev:worker-host": "npm run build:assets && wrangler dev --ip 0.0.0.0",
    "dev:node": "npm run build:assets && tsx src/node.ts",
    "dev:tg": "npm run build:assets && tsx src/tg-lp.ts",
    "get": "tsx src/cli.ts",
    "kv:refresh": "tsx src/cf-cli.ts --refresh-meta",
    "kv:export": "tsx src/cf-cli.ts --export",
    "kv:import": "tsx src/cf-cli.ts --import",
    "deploy": "npm run build:assets && wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@cf-wasm/og": "^0.3.8",
    "@hono/node-server": "^2.0.1",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^0.18.4",
    "@types/d3-shape": "^3.1.8",
    "@visx/scale": "^3.12.0",
    "d3-shape": "^3.2.0",
    "dotenv": "^17.4.2",
    "grammy": "^1.42.0",
    "hono": "^4.12.17",
    "node-addon-api": "^8.7.0",
    "node-gyp": "^12.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "subset-font": "^2.5.0",
    "swagger-ui-dist": "^5.32.6",
    "tsx": "^4.21.0",
    "victory": "^37.3.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "daisyui": "^5.5.19",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12",
    "wrangler": "^4.90.1"
  },
  "author": "Yuan Chiu",
  "license": "MPL-2.0"
}
