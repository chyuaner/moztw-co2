{
  "name": "space-info-api",
  "type": "module",
  "scripts": {
    "build:assets": "tsx scripts/generate-assets.ts",
    "dev": "npm run build:assets && npm run dev:worker",
    "dev:worker": "npm run build:assets && wrangler dev",
    "dev:node": "npm run build:assets && tsx src/node.ts",
    "dev:tg": "npm run build:assets && tsx src/tg-lp.ts",
    "get": "tsx src/cli.ts",
    "kv:refresh": "tsx src/cf-cli.ts --refresh-meta",
    "kv:export": "tsx src/cf-cli.ts --export",
    "kv:import": "tsx src/cf-cli.ts --import",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@cf-wasm/og": "^0.3.8",
    "@hono/node-server": "^2.0.1",
    "@types/d3-shape": "^3.1.8",
    "@visx/axis": "^3.12.0",
    "@visx/curve": "^3.12.0",
    "@visx/group": "^3.12.0",
    "@visx/scale": "^3.12.0",
    "@visx/shape": "^3.12.0",
    "d3-shape": "^3.2.0",
    "dotenv": "^17.4.2",
    "grammy": "^1.42.0",
    "hono": "^4.12.17",
    "node-addon-api": "^8.7.0",
    "node-gyp": "^12.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "subset-font": "^2.5.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "wrangler": "^4.90.1"
  },
  "author": "Yuan Chiu",
  "license": "MPL-2.0"
}
