{
  "name": "space-info-api",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:worker",
    "dev:worker": "wrangler dev",
    "dev:node": "tsx src/node.ts",
    "dev:tg": "tsx src/tg-lp.ts",
    "get": "tsx src/cli.ts",
    "kv:refresh": "tsx src/cf-cli.ts --refresh-meta",
    "kv:export": "tsx src/cf-cli.ts --export",
    "kv:import": "tsx src/cf-cli.ts --import",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.1",
    "dotenv": "^17.4.2",
    "grammy": "^1.42.0",
    "hono": "^4.12.17",
    "node-addon-api": "^8.7.0",
    "node-gyp": "^12.3.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "wrangler": "^4.90.1"
  },
  "author": "Yuan Chiu",
  "license": "MPL-2.0"
}
