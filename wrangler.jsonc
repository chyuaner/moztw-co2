{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "moztw-co2",
	"main": "src/worker.ts",
	"compatibility_date": "2026-05-06",
	// "compatibility_flags": [
	//   "nodejs_compat"
	// ],
	"vars": {
		"SENSOR_STORAGE": "d1"
	},
	"build": {
		"command": "npm run build:assets",
		"watch_dir": "README.md"
	},

	"kv_namespaces": [
		{
			"binding": "SENSOR_KV",
			"id": "b18aeeed328d461c9ef8450dbb8916f4",
			"remote": true
		}
	],
	// "r2_buckets": [
	//   {
	//     "binding": "MY_BUCKET",
	//     "bucket_name": "my-bucket"
	//   }
	// ],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "moztw-co2-db",
			"database_id": "moztw-co2-db"
		}
	],
	// "ai": {
	//   "binding": "AI"
	// },
	"observability": {
	  "enabled": true,
	  "head_sampling_rate": 1
	}
}